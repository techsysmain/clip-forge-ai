# ===== Required =====
# MySQL 8+ connection string
DATABASE_URL=mysql://clipforge:change-me@localhost:3306/clipforge
# Used by docker-compose to create the database
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Generate with: openssl rand -base64 48   (required in production)
AUTH_SECRET=
# Public base URL of the web app (used in sign-in links and emails)
APP_URL=http://localhost:3000
# Directory shared by the web app and worker (mount the same volume in production)
STORAGE_DIR=./storage

# ===== AI provider (set ONE key; the worker needs it) =====
# AI_PROVIDER=openai          # or gemini; auto-detected from whichever key is set
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ===== Email via Resend (sign-in links + notifications) =====
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend (onboarding@resend.dev only delivers to your own account)
EMAIL_FROM="ClipForge AI <no-reply@yourdomain.com>"

# ===== Optional =====
# YouTube Data API v3 key: adds video duration to YouTube metadata
YOUTUBE_API_KEY=
MAX_UPLOAD_MB=1024
MAX_SOURCE_SECONDS=7200
RETENTION_DAYS=30
WORKER_CONCURRENCY=1
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ===== Legal pages (shown in /privacy, /terms, ...) =====
LEGAL_COMPANY_NAME="Your Company Ltd."
LEGAL_CONTACT_EMAIL=legal@yourdomain.com
LEGAL_PRIVACY_EMAIL=privacy@yourdomain.com
LEGAL_ADDRESS="123 Example Street, City, Country"
LEGAL_JURISDICTION="England and Wales"
LEGAL_LAST_UPDATED="June 1, 2025"
